#!name=ifywnx-Captions-Test
#!desc=Thử nghiệm caption riêng; KHÔNG can thiệp quyền thuê bao
# MẪU: thay YOUR_PUBLIC_HTTPS_HOST bằng máy chủ HTTPS truy cập được.
# GitHub private không cung cấp link Raw công khai cho thiết bị chưa đăng nhập.

[Script]
locket_caption_test = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/namespaces\/firebase:fetch(?:\?.*)?$, script-path=https://YOUR_PUBLIC_HTTPS_HOST/ifywnx-tests/captions/Locket_Captions_Test.js, requires-body=true, max-size=524288, timeout=30

[MITM]
hostname = %APPEND% firebaseremoteconfig.googleapis.com
