#!name=ifywnx-RevenueCat-Diagnostics
#!desc=Read-only RevenueCat response shape; no entitlement changes
# TEMPLATE: replace YOUR_PUBLIC_HTTPS_HOST before importing.

[Script]
revenuecat_diag = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/subscribers\/[^/]+(?:\?.*)?$, script-path=https://YOUR_PUBLIC_HTTPS_HOST/ifywnx-tests/revenuecat/RevenueCat_Readonly_Diagnostics.js, requires-body=true, max-size=524288, timeout=30

[MITM]
hostname = %APPEND% api.revenuecat.com
