#!name=Locket Gold Research - ifywnx
#!desc=Ban tuy chinh de nghien cuu, khong chinh thuc, chua duoc chung nhan an toan
#!author=ifywnx (customization), duyvinh09 (upstream source)
#!homepage=https://github.com/ifywnx/locket-gold-ywnx
#!moduleUrl=https://raw.githubusercontent.com/ifywnx/locket-gold-ywnx/main/Locket_ifywnx.sgmodule
#!howtouse=Shadowrocket

# DANGER: HTTPS interception of purchase-related traffic.
# Do not deploy to others or use with sensitive accounts without a full independent audit.
# Upstream original: https://github.com/duyvinh09/Module_IOS

[Script]
locket_revenuecat = type=http-response,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$),script-path=https://raw.githubusercontent.com/ifywnx/locket-gold-ywnx/main/upstream/js/Locket_DuyVinh09.js,requires-body=true,max-size=-1,timeout=60
locket_delete_header = type=http-request,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),script-path=https://raw.githubusercontent.com/ifywnx/locket-gold-ywnx/main/upstream/js/deleteHeader.js,timeout=60
locket_remote_config = type=http-response,pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+,script-path=https://raw.githubusercontent.com/ifywnx/locket-gold-ywnx/main/js/Locket_ifywnx.js,requires-body=true,max-size=-1,timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
